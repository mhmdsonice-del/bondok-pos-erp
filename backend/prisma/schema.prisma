// ============================================================
// Bondok POS + Back Office + ERP — Database Schema
// PostgreSQL + Prisma ORM
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  SUPER_ADMIN
  ADMIN
  BRANCH_MANAGER
  CASHIER
  KITCHEN
  ACCOUNTANT
  INVENTORY_CLERK
  HR_MANAGER
}

enum OrderStatus {
  DRAFT
  HELD
  OPEN
  COMPLETED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  MERGED
  SPLIT
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  CASH
  VISA
  WALLET
  MIXED
  OTHER
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  PARTIALLY_REFUNDED
}

enum StockMovementType {
  PURCHASE_IN
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTE
  RETURN_IN
  RETURN_OUT
  SALE_OUT
  STOCKTAKE_CORRECTION
  RECIPE_CONSUMPTION
}

enum CashMovementType {
  RECEIPT
  PAYMENT
  TRANSFER
  ADJUSTMENT
  OPENING
  CLOSING
  REFUND
  SALE_RECEIPT
  REFUND_PAYOUT
}

enum AttendanceStatus {
  CHECK_IN
  CHECK_OUT
  BREAK_START
  BREAK_END
}

enum PayrollStatus {
  DRAFT
  REVIEW
  APPROVED
  PAID
  LOCKED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundType {
  FULL
  PARTIAL
}

// ============================================================
// COMPANY / BRANCHES
// ============================================================

model Company {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?
  taxNumber   String?
  currency    String   @default("EGP")
  language    String   @default("ar")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branches          Branch[]
  users             User[]
  products          Product[]
  customers         Customer[]
  suppliers         Supplier[]
  taxes             Tax[]
  expenseCategories ExpenseCategory[]
  settings          Setting[]
}

model Branch {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  address   String?
  phone     String?
  isActive  Boolean @default(true)
  createdAt DateTime @default(now())

  users            UserBranch[]
  warehouses       Warehouse[]
  orders           Order[]
  cashRegisters    CashRegister[]
  attendances      Attendance[]
  wasteEntries     WasteEntry[]
  expenses         Expense[]
  shifts           Shift[]

  @@index([companyId])
}

// ============================================================
// USERS / EMPLOYEES / RBAC
// ============================================================

model User {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id])
  fullName         String
  username         String   @unique
  email            String?  @unique
  phone            String?
  passwordHash     String
  role             UserRole
  employeeId       String?  @unique
  hourlyRate       Decimal? @db.Decimal(10, 2)
  monthlySalary    Decimal? @db.Decimal(12, 2)
  overtimeRate     Decimal? @db.Decimal(10, 2)
  joinDate         DateTime?
  isActive         Boolean  @default(true)
  twoFactorEnabled Boolean  @default(false)
  twoFactorSecret  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  branches           UserBranch[]
  ordersCreated      Order[]          @relation("OrderCreatedBy")
  ordersCancelled    Order[]          @relation("OrderCancelledBy")
  attendances        Attendance[]
  auditLogs          AuditLog[]
  performanceReviews PerformanceReview[]
  cashMovements      CashMovement[]
  leaves             Leave[]          @relation("LeaveEmployee")
  approvedLeaves     Leave[]          @relation("LeaveApprover")
  advances           Advance[]
  penalties          Penalty[]
  rewards            Reward[]
  payrollRecords     PayrollRecord[]
  lockedPayrolls     PayrollRecord[]  @relation("PayrollLockedBy")
  shiftAssignments   ShiftAssignment[]
  notifications      Notification[]
  openedRegisters    CashRegister[]
  refundsCreated     Refund[]

  @@index([companyId])
}

model UserBranch {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, branchId])
}

model Attendance {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  branchId  String
  branch    Branch           @relation(fields: [branchId], references: [id])
  status    AttendanceStatus
  timestamp DateTime         @default(now())
  notes     String?

  @@index([userId, timestamp])
}

model PerformanceReview {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  score       Decimal  @db.Decimal(5, 2)
  notes       String?
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
}

// ============================================================
// PRODUCTS / CATALOG
// ============================================================

model Category {
  id       String    @id @default(uuid())
  name     String
  parentId String?
  parent   Category? @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")
  products Product[]
}

model Unit {
  id       String   @id @default(uuid())
  name     String
  products Product[]
}

model Product {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  unitId      String?
  unit        Unit?    @relation(fields: [unitId], references: [id])
  sku         String   @unique
  barcode     String?  @unique
  qrCode      String?
  name        String
  nameEn      String?
  description String?
  imageUrl    String?
  costPrice   Decimal  @db.Decimal(12, 3)
  sellPrice   Decimal  @db.Decimal(10, 2)
  isComposite Boolean  @default(false)
  isActive    Boolean  @default(true)
  reorderPoint Decimal? @db.Decimal(10, 2)
  allowRefund  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants       ProductVariant[]
  modifiers      ProductModifier[]
  comboItems     ComboItem[]         @relation("ParentProduct")
  usedInCombos   ComboItem[]         @relation("ChildProduct")
  stockLevels    StockLevel[]
  stockMovements StockMovement[]
  orderItems     OrderItem[]
  purchaseItems  PurchaseItem[]
  recipeItems    RecipeItem[]        @relation("RecipeProduct")
  usedInRecipes  RecipeItem[]        @relation("RecipeRawMaterial")
  wasteEntries   WasteEntry[]

  @@index([companyId])
}

model ProductVariant {
  id         String      @id @default(uuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id])
  name       String
  priceDelta Decimal     @db.Decimal(10, 2) @default(0)
  barcode    String?
  isActive   Boolean     @default(true)

  orderItems OrderItem[]
}

model ProductModifier {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id])
  name      String
  price     Decimal @db.Decimal(10, 2)
  isActive  Boolean @default(true)
}

model ComboItem {
  id              String  @id @default(uuid())
  parentProductId String
  parentProduct   Product @relation("ParentProduct", fields: [parentProductId], references: [id])
  childProductId  String
  childProduct    Product @relation("ChildProduct", fields: [childProductId], references: [id])
  quantity        Decimal @db.Decimal(10, 2) @default(1)
}

model RecipeItem {
  id             String  @id @default(uuid())
  productId      String
  product        Product @relation("RecipeProduct", fields: [productId], references: [id])
  rawMaterialId  String
  rawMaterial    Product @relation("RecipeRawMaterial", fields: [rawMaterialId], references: [id])
  quantity       Decimal @db.Decimal(12, 3)
  unitName       String?
}

// ============================================================
// INVENTORY / WAREHOUSES
// ============================================================

model Warehouse {
  id       String  @id @default(uuid())
  branchId String
  branch   Branch  @relation(fields: [branchId], references: [id])
  name     String
  isActive Boolean @default(true)

  stockLevels    StockLevel[]
  stockMovements StockMovement[]
}

model StockLevel {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(12, 3) @default(0)
  batchNumber String?
  expiryDate  DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([warehouseId, productId, batchNumber])
}

model StockMovement {
  id          String            @id @default(uuid())
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  type        StockMovementType
  quantity    Decimal           @db.Decimal(12, 3)
  unitCost    Decimal?          @db.Decimal(12, 3)
  batchNumber String?
  expiryDate  DateTime?
  reference   String?
  notes       String?
  createdAt   DateTime          @default(now())

  @@index([warehouseId, productId])
  @@index([reference])
}

// ============================================================
// CUSTOMERS
// ============================================================

model Customer {
  id            String   @id @default(uuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  name          String
  phone         String?  @unique
  email         String?
  loyaltyPoints Int      @default(0)
  balance       Decimal  @db.Decimal(10, 2) @default(0)
  creditLimit   Decimal  @db.Decimal(10, 2) @default(0)
  notes         String?
  createdAt     DateTime @default(now())

  orders  Order[]
  coupons Coupon[]

  @@index([companyId])
}

model Coupon {
  id           String    @id @default(uuid())
  code         String    @unique
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  discountType String
  value        Decimal   @db.Decimal(10, 2)
  expiryDate   DateTime?
  isUsed       Boolean   @default(false)

  orders Order[]
}

// ============================================================
// SUPPLIERS / PURCHASING
// ============================================================

model Supplier {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  phone     String?
  balance   Decimal  @db.Decimal(10, 2) @default(0)

  purchases Purchase[]

  @@index([companyId])
}

model Purchase {
  id          String          @id @default(uuid())
  supplierId  String
  supplier    Supplier        @relation(fields: [supplierId], references: [id])
  invoiceNo   String?
  totalAmount Decimal         @db.Decimal(10, 2)
  paidAmount  Decimal         @db.Decimal(10, 2) @default(0)
  createdAt   DateTime        @default(now())

  items       PurchaseItem[]
  payments    SupplierPayment[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(12, 3)
  unitCost   Decimal  @db.Decimal(10, 2)
}

model SupplierPayment {
  id         String        @id @default(uuid())
  purchaseId String
  purchase   Purchase      @relation(fields: [purchaseId], references: [id])
  amount     Decimal       @db.Decimal(10, 2)
  method     PaymentMethod
  createdAt  DateTime      @default(now())
}

// ============================================================
// TAXES
// ============================================================

model Tax {
  id        String  @id @default(uuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  name      String
  rate      Decimal @db.Decimal(5, 2)
  isActive  Boolean @default(true)
}

// ============================================================
// ORDERS / POS
// ============================================================

model OrderCounter {
  branchId String
  dateKey  String
  counter  Int

  @@id([branchId, dateKey])
}

model Order {
  id              String        @id @default(uuid())
  branchId        String
  branch          Branch        @relation(fields: [branchId], references: [id])
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  createdById     String
  createdBy       User          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  orderNumber     String        @unique
  type            OrderType     @default(DINE_IN)
  status          OrderStatus   @default(DRAFT)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Decimal       @db.Decimal(10, 2)
  discountAmount  Decimal       @db.Decimal(10, 2) @default(0)
  taxAmount       Decimal       @db.Decimal(10, 2) @default(0)
  serviceAmount   Decimal       @db.Decimal(10, 2) @default(0)
  totalAmount     Decimal       @db.Decimal(10, 2)
  paidAmount      Decimal       @db.Decimal(10, 2) @default(0)
  couponId        String?
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  parentOrderId   String?
  sourceOrderId   String?
  cancelReason    String?
  cancelledById   String?
  cancelledBy     User?         @relation("OrderCancelledBy", fields: [cancelledById], references: [id])
  cancelledAt     DateTime?
  completedAt     DateTime?
  clientTransactionId String?   @unique
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  items           OrderItem[]
  payments        Payment[]
  refunds         Refund[]
  cashMovements   CashMovement[]
  childOrders     Order[]       @relation("OrderSplit")
  parentOrder     Order?        @relation("OrderSplit", fields: [parentOrderId], references: [id])

  @@index([branchId, status])
  @@index([customerId])
  @@index([sourceOrderId])
}

model OrderItem {
  id            String         @id @default(uuid())
  orderId       String
  order         Order          @relation(fields: [orderId], references: [id])
  productId     String
  product       Product        @relation(fields: [productId], references: [id])
  variantId     String?
  variant       ProductVariant? @relation(fields: [variantId], references: [id])
  quantity      Decimal        @db.Decimal(10, 3)
  unitPrice     Decimal        @db.Decimal(10, 2)
  discount      Decimal        @db.Decimal(10, 2) @default(0)
  modifierTotal Decimal        @db.Decimal(10, 2) @default(0)
  modifiers     Json?
  notes         String?

  refundItems   RefundItem[]
}

model Payment {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  method          PaymentMethod
  amount          Decimal       @db.Decimal(10, 2)
  cashMovementId  String?
  cashMovement    CashMovement? @relation("PaymentCashMovement", fields: [cashMovementId], references: [id])
  cashRegisterId  String?
  cashRegister    CashRegister? @relation(fields: [cashRegisterId], references: [id])
  isReversed      Boolean       @default(false)
  reversedAt      DateTime?
  reversalReason  String?
  createdAt       DateTime      @default(now())
}

model Refund {
  id              String        @id @default(uuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id])
  type            RefundType
  amount          Decimal       @db.Decimal(10, 2)
  reason          String?
  createdById     String
  createdBy       User          @relation(fields: [createdById], references: [id])
  cashMovementId  String?
  cashMovement    CashMovement? @relation("RefundCashMovement", fields: [cashMovementId], references: [id])
  items           RefundItem[]
  createdAt       DateTime      @default(now())
}

model RefundItem {
  id          String    @id @default(uuid())
  refundId    String
  refund      Refund    @relation(fields: [refundId], references: [id])
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id])
  quantity    Decimal   @db.Decimal(10, 3)
  amount      Decimal   @db.Decimal(10, 2)
}

// ============================================================
// CASH REGISTER
// ============================================================

model CashRegister {
  id            String   @id @default(uuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id])
  openedById    String
  openedBy      User     @relation(fields: [openedById], references: [id])
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  openingAmount Decimal  @db.Decimal(10, 2)
  closingAmount Decimal? @db.Decimal(10, 2)
  isClosed      Boolean  @default(false)

  movements     CashMovement[]
  payments      Payment[]

  @@index([branchId, isClosed])
}

model CashMovement {
  id             String           @id @default(uuid())
  cashRegisterId String
  cashRegister   CashRegister     @relation(fields: [cashRegisterId], references: [id])
  userId         String
  user           User             @relation(fields: [userId], references: [id])
  type           CashMovementType
  amount         Decimal          @db.Decimal(10, 2)
  orderId        String?
  order          Order?           @relation(fields: [orderId], references: [id])
  referenceId    String?
  notes          String?
  createdAt      DateTime         @default(now())

  paymentLinks   Payment[]        @relation("PaymentCashMovement")
  refundLinks    Refund[]         @relation("RefundCashMovement")

  @@index([cashRegisterId, type])
}

// ============================================================
// HR / PAYROLL
// ============================================================

model Leave {
  id           String      @id @default(uuid())
  userId       String
  user         User        @relation("LeaveEmployee", fields: [userId], references: [id])
  type         String      @default("ANNUAL")
  startDate    DateTime
  endDate      DateTime
  status       LeaveStatus @default(PENDING)
  reason       String?
  approvedById String?
  approvedBy   User?       @relation("LeaveApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Advance {
  id              String   @id @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  amount          Decimal  @db.Decimal(10, 2)
  remainingAmount Decimal  @db.Decimal(10, 2)
  reason          String?
  isSettled       Boolean  @default(false)
  settledAt       DateTime?
  createdAt       DateTime @default(now())
}

model Penalty {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  type       String   @default("LATE")
  amount     Decimal  @db.Decimal(10, 2)
  reason     String?
  isDeducted Boolean  @default(false)
  deductedAt DateTime?
  createdAt  DateTime @default(now())
}

model Reward {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Decimal  @db.Decimal(10, 2)
  reason    String?
  isPaid    Boolean  @default(false)
  paidAt    DateTime?
  createdAt DateTime @default(now())
}

model PayrollRecord {
  id                String        @id @default(uuid())
  userId            String
  user              User          @relation(fields: [userId], references: [id])
  periodStart       DateTime
  periodEnd         DateTime
  baseSalary        Decimal       @db.Decimal(12, 2)
  hourlyRate        Decimal?      @db.Decimal(10, 2)
  hoursWorked       Decimal?      @db.Decimal(8, 2)
  overtimeHours     Decimal?      @db.Decimal(8, 2)
  overtimePay       Decimal?      @db.Decimal(10, 2)
  allowances        Decimal       @db.Decimal(10, 2) @default(0)
  bonuses           Decimal       @db.Decimal(10, 2) @default(0)
  deductions        Decimal       @db.Decimal(10, 2) @default(0)
  penaltiesTotal    Decimal       @db.Decimal(10, 2) @default(0)
  advancesRecovered Decimal       @db.Decimal(10, 2) @default(0)
  lateDeductions    Decimal       @db.Decimal(10, 2) @default(0)
  absenceDeductions Decimal       @db.Decimal(10, 2) @default(0)
  rewards           Decimal       @db.Decimal(10, 2) @default(0)
  netSalary         Decimal       @db.Decimal(12, 2)
  status            PayrollStatus @default(DRAFT)
  lockedById        String?
  lockedBy          User?         @relation("PayrollLockedBy", fields: [lockedById], references: [id])
  lockedAt          DateTime?
  paidAt            DateTime?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId, periodStart, periodEnd])
}

model Shift {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  name      String
  startTime String
  endTime   String
  isActive  Boolean  @default(true)

  assignments ShiftAssignment[]
}

model ShiftAssignment {
  id     String   @id @default(uuid())
  shiftId String
  shift  Shift    @relation(fields: [shiftId], references: [id])
  userId String
  user   User     @relation(fields: [userId], references: [id])
  date   DateTime
}

// ============================================================
// EXPENSES
// ============================================================

model ExpenseCategory {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  isActive  Boolean  @default(true)

  expenses  Expense[]
}

model Expense {
  id            String          @id @default(uuid())
  branchId      String
  branch        Branch          @relation(fields: [branchId], references: [id])
  categoryId    String?
  category      ExpenseCategory? @relation(fields: [categoryId], references: [id])
  amount        Decimal         @db.Decimal(10, 2)
  description   String?
  attachmentUrl String?
  createdById   String?
  createdAt     DateTime        @default(now())
}

// ============================================================
// WASTE
// ============================================================

model WasteEntry {
  id          String   @id @default(uuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id])
  warehouseId String
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  quantity    Decimal  @db.Decimal(12, 3)
  unitCost    Decimal? @db.Decimal(12, 3)
  totalCost   Decimal? @db.Decimal(12, 2)
  reason      String?
  userId      String?
  notes       String?
  createdAt   DateTime @default(now())

  @@index([branchId, createdAt])
}

// ============================================================
// NOTIFICATIONS
// ============================================================

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  title     String
  body      String
  type      String    @default("INFO")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// ============================================================
// SETTINGS
// ============================================================

model Setting {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  @@unique([companyId, key])
}
