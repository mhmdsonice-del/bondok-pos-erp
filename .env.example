# ============================================
# Bondok ERP/POS — Environment Variables
# ============================================

# --- General ---
NODE_ENV=production

# --- Backend ---
BACKEND_PORT=4000
DATABASE_URL="postgresql://user:password@postgres:5432/bondok_pos?schema=public"
REDIS_URL="redis://redis:6379"

JWT_ACCESS_SECRET="change_me_access_secret_min_16_chars"
JWT_REFRESH_SECRET="change_me_refresh_secret_min_16_chars"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

CORS_ORIGIN="http://localhost:5173"

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
VITE_SOCKET_URL=http://localhost:4000

# --- Optional: S3-compatible storage ---
# STORAGE_ENDPOINT="https://s3.amazonaws.com"
# STORAGE_BUCKET="bondok-uploads"
# STORAGE_ACCESS_KEY="access_key"
# STORAGE_SECRET_KEY="secret_key"

# --- Optional: Backup ---
# BACKUP_ENABLED=true
# BACKUP_CRON="0 2 * * *"
# BACKUP_RETENTION_DAYS=30